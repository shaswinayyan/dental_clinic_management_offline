# ─── Vorsa Cloud API — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: full connection string (recommended for cloud providers)
DATABASE_URL=postgresql://vorsa_user:strongpassword@localhost:5432/vorsa

# Option B: individual params (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=vorsa_user
PGPASSWORD=strongpassword
PGDATABASE=vorsa
PG_POOL_MAX=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_replace_with_64_random_hex_chars_for_production
JWT_REFRESH_SECRET=CHANGE_ME_replace_with_64_different_random_hex_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Allow your frontend origin (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in ms
RATE_LIMIT_MAX=300             # requests per window per IP (general)
AUTH_RATE_LIMIT_MAX=20         # stricter limit for /auth routes

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_BYTES=10485760        # 10 MB
