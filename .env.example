# ─────────────────────────────────────────────────────────────────────────────
# VORSA Cloud v2 — Environment Variables
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (https://supabase.com) ──────────────────────────────────────────
# Project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role key — BACKEND ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database — Supabase PostgreSQL ────────────────────────────────────────────
# Project → Settings → Database → Connection string → URI
# Use the "Session pooler" URL (port 6543) for the app
DATABASE_URL=postgresql://postgres.xxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ── API Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Web App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v2

# ── Upstash Redis (OPTIONAL — rate limiting disabled without this) ────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx
